<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the database to the Google account and copy it to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="SQLite/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="SQLite/" />
    </device-transfer>
</data-extraction-rules>
